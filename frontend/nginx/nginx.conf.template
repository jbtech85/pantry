server {
  listen 80;

  # for the future
  server_name _;

  root /usr/share/nginx/html;

  # default file when a directory is requested
  index index.html;

  ### review further later
  gzip on;
  gzip_types text/plain text/css application/javascript application/json;
  gzip_min_length 1000;

  # never cache the entry point
  location = /index.html {
      add_header Cache-Control "no-cache, no-store, must-revalidate";
  }

  # cache fingerprinted assets aggressively
  location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
      expires 1y;
      add_header Cache-Control "public, immutable";
  }

  # handle API requests and proxy them to Express backend
  location /api/ {
    proxy_pass http://pantryapi:${SERVER_PORT}/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # handle all other requests
  location / {
    try_files $uri $uri/ /index.html;
  }

  error_page 404 /index.html;
}